{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NodeAccepted",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "accepted"
      ]
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    }
  },
  "additionalProperties": false,
  "required": [
    "status",
    "node_id"
  ]
}
