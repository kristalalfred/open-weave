{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StreamAccepted",
  "type": "object",
  "properties": {
    "status": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "accepted"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "generation": {
      "type": "integer",
      "format": "uint64",
      "minimum": 1
    },
    "changed": {
      "type": "boolean"
    }
  },
  "required": [
    "status",
    "name",
    "generation",
    "changed"
  ]
}
