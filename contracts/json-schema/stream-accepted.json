{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "changed": {
      "type": "boolean"
    },
    "generation": {
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "name": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "enum": [
            "accepted"
          ],
          "type": "string"
        },
        {
          "type": "string"
        }
      ]
    }
  },
  "required": [
    "status",
    "name",
    "generation",
    "changed"
  ],
  "title": "StreamAccepted",
  "type": "object"
}
