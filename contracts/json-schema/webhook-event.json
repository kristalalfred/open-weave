{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "node.registered",
            "node.online",
            "node.offline",
            "node.forgotten",
            "stream.changed"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "occurred_at": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "occurred_at"
  ],
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "node": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "status": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "unknown",
                    "ready",
                    "degraded",
                    "offline"
                  ]
                },
                {
                  "type": "string"
                }
              ]
            },
            "endpoint": {
              "type": "string"
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "adapters": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "kind": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "native_srt",
                              "strom",
                              "spaghetti",
                              "nmos",
                              "mxl_domain",
                              "mxl_k8s",
                              "mcm",
                              "vendor",
                              "custom"
                            ]
                          },
                          {
                            "type": "string"
                          }
                        ]
                      }
                    },
                    "required": [
                      "name",
                      "kind"
                    ]
                  },
                  "default": []
                },
                "hop_profiles": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "timed_delivery": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "properties": {
                          "protocol": {
                            "type": "string"
                          },
                          "roles": {
                            "type": "array",
                            "items": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "enum": [
                                    "origin",
                                    "forward",
                                    "receiver"
                                  ]
                                },
                                {
                                  "type": "string"
                                }
                              ]
                            }
                          },
                          "max_latency_ms": {
                            "type": "integer",
                            "format": "uint32",
                            "minimum": 0
                          },
                          "scheduling_error_bound_us": {
                            "type": "integer",
                            "format": "uint32",
                            "minimum": 0
                          },
                          "clock_domain": {
                            "type": "string"
                          },
                          "origin_epoch": {
                            "type": "integer",
                            "format": "uint64",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "protocol",
                          "roles",
                          "max_latency_ms",
                          "scheduling_error_bound_us",
                          "clock_domain",
                          "origin_epoch"
                        ]
                      },
                      "media_behavior": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "preserve",
                              "unknown"
                            ],
                            "default": "unknown"
                          },
                          {
                            "type": "string"
                          }
                        ]
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 63,
                        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
                      },
                      "ingress": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "transport": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "enum": [
                                      "srt",
                                      "whip",
                                      "whep",
                                      "rist"
                                    ]
                                  },
                                  {
                                    "type": "string"
                                  }
                                ]
                              },
                              "roles": {
                                "type": "array",
                                "items": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "enum": [
                                        "listen",
                                        "connect"
                                      ]
                                    },
                                    {
                                      "type": "string"
                                    }
                                  ]
                                },
                                "minItems": 1
                              }
                            },
                            "required": [
                              "transport",
                              "roles"
                            ]
                          },
                          {
                            "anyOf": [
                              {
                                "type": "string",
                                "enum": [
                                  "input",
                                  "output"
                                ]
                              },
                              {
                                "type": "string"
                              }
                            ]
                          }
                        ]
                      },
                      "egress": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "transport": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "enum": [
                                      "srt",
                                      "whip",
                                      "whep",
                                      "rist"
                                    ]
                                  },
                                  {
                                    "type": "string"
                                  }
                                ]
                              },
                              "roles": {
                                "type": "array",
                                "items": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "enum": [
                                        "listen",
                                        "connect"
                                      ]
                                    },
                                    {
                                      "type": "string"
                                    }
                                  ]
                                },
                                "minItems": 1
                              }
                            },
                            "required": [
                              "transport",
                              "roles"
                            ]
                          },
                          {
                            "anyOf": [
                              {
                                "type": "string",
                                "enum": [
                                  "input",
                                  "output"
                                ]
                              },
                              {
                                "type": "string"
                              }
                            ]
                          }
                        ]
                      },
                      "max_egresses": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "format": "uint",
                        "minimum": 1
                      },
                      "merge": {
                        "type": "boolean"
                      },
                      "accepts": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "properties": {
                          "container": {
                            "type": [
                              "array",
                              "null"
                            ],
                            "items": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "enum": [
                                    "mpeg_ts",
                                    "rtp"
                                  ]
                                },
                                {
                                  "type": "string"
                                }
                              ]
                            },
                            "minItems": 1
                          },
                          "video": {
                            "type": [
                              "object",
                              "null"
                            ],
                            "properties": {
                              "codec": {
                                "type": [
                                  "array",
                                  "null"
                                ],
                                "items": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "enum": [
                                        "h264",
                                        "h265",
                                        "av1",
                                        "vp8",
                                        "vp9"
                                      ]
                                    },
                                    {
                                      "type": "string"
                                    }
                                  ]
                                },
                                "minItems": 1
                              },
                              "width": {
                                "type": [
                                  "array",
                                  "null"
                                ],
                                "items": {
                                  "type": "integer",
                                  "format": "uint32",
                                  "minimum": 0
                                },
                                "minItems": 1
                              },
                              "height": {
                                "type": [
                                  "array",
                                  "null"
                                ],
                                "items": {
                                  "type": "integer",
                                  "format": "uint32",
                                  "minimum": 0
                                },
                                "minItems": 1
                              },
                              "framerate": {
                                "type": [
                                  "array",
                                  "null"
                                ],
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "numerator": {
                                      "type": "integer",
                                      "format": "uint32",
                                      "minimum": 0
                                    },
                                    "denominator": {
                                      "type": "integer",
                                      "format": "uint32",
                                      "minimum": 0
                                    }
                                  },
                                  "required": [
                                    "numerator",
                                    "denominator"
                                  ]
                                },
                                "minItems": 1
                              },
                              "chroma_subsampling": {
                                "type": [
                                  "array",
                                  "null"
                                ],
                                "items": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "enum": [
                                        "yuv420",
                                        "yuv422",
                                        "yuv444"
                                      ]
                                    },
                                    {
                                      "type": "string"
                                    }
                                  ]
                                },
                                "minItems": 1
                              }
                            }
                          },
                          "audio": {
                            "type": [
                              "object",
                              "null"
                            ],
                            "properties": {
                              "codec": {
                                "type": [
                                  "array",
                                  "null"
                                ],
                                "items": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "enum": [
                                        "aac",
                                        "opus",
                                        "mp2",
                                        "pcm_s16",
                                        "pcm_s24"
                                      ]
                                    },
                                    {
                                      "type": "string"
                                    }
                                  ]
                                },
                                "minItems": 1
                              },
                              "sample_rate": {
                                "type": [
                                  "array",
                                  "null"
                                ],
                                "items": {
                                  "type": "integer",
                                  "format": "uint32",
                                  "minimum": 0
                                },
                                "minItems": 1
                              },
                              "channels": {
                                "type": [
                                  "array",
                                  "null"
                                ],
                                "items": {
                                  "type": "integer",
                                  "format": "uint8",
                                  "minimum": 0,
                                  "maximum": 255
                                },
                                "minItems": 1
                              }
                            }
                          }
                        }
                      }
                    },
                    "required": [
                      "media_behavior",
                      "id",
                      "ingress",
                      "egress"
                    ]
                  },
                  "default": []
                }
              },
              "default": {
                "adapters": [],
                "hop_profiles": []
              },
              "required": [
                "adapters",
                "hop_profiles"
              ]
            },
            "topology": {
              "type": "object",
              "properties": {
                "attachments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 63,
                        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
                      },
                      "network": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 63,
                        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
                      },
                      "dial": {
                        "type": "boolean",
                        "default": false
                      },
                      "listeners": {
                        "type": "object",
                        "properties": {
                          "srt": {
                            "type": [
                              "object",
                              "null"
                            ],
                            "properties": {
                              "host": {
                                "type": "string"
                              },
                              "port_range": {
                                "type": "object",
                                "properties": {
                                  "start": {
                                    "type": "integer",
                                    "format": "uint16",
                                    "minimum": 0,
                                    "maximum": 65535
                                  },
                                  "end": {
                                    "type": "integer",
                                    "format": "uint16",
                                    "minimum": 0,
                                    "maximum": 65535
                                  }
                                },
                                "required": [
                                  "start",
                                  "end"
                                ]
                              }
                            },
                            "required": [
                              "host",
                              "port_range"
                            ]
                          },
                          "whip": {
                            "type": [
                              "object",
                              "null"
                            ],
                            "properties": {
                              "base_url": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "base_url"
                            ]
                          },
                          "whep": {
                            "type": [
                              "object",
                              "null"
                            ],
                            "properties": {
                              "base_url": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "base_url"
                            ]
                          },
                          "rist": {
                            "type": [
                              "object",
                              "null"
                            ],
                            "properties": {
                              "host": {
                                "type": "string"
                              },
                              "port_range": {
                                "type": "object",
                                "properties": {
                                  "start": {
                                    "type": "integer",
                                    "format": "uint16",
                                    "minimum": 0,
                                    "maximum": 65535
                                  },
                                  "end": {
                                    "type": "integer",
                                    "format": "uint16",
                                    "minimum": 0,
                                    "maximum": 65535
                                  }
                                },
                                "required": [
                                  "start",
                                  "end"
                                ]
                              }
                            },
                            "required": [
                              "host",
                              "port_range"
                            ]
                          }
                        },
                        "default": {}
                      }
                    },
                    "required": [
                      "id",
                      "network",
                      "dial",
                      "listeners"
                    ]
                  },
                  "default": []
                }
              },
              "required": [
                "attachments"
              ]
            }
          },
          "required": [
            "id",
            "status",
            "endpoint",
            "capabilities",
            "topology"
          ]
        }
      },
      "required": [
        "node"
      ]
    },
    {
      "type": "object",
      "properties": {
        "stream": {
          "type": "object",
          "properties": {
            "format_policy": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "report",
                    "strict"
                  ]
                },
                {
                  "type": "string"
                }
              ]
            },
            "name": {
              "type": "string"
            },
            "generation": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "observed_generation": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "status": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "idle",
                    "failed",
                    "pending",
                    "awaiting_input",
                    "degraded",
                    "flowing"
                  ]
                },
                {
                  "type": "string"
                }
              ]
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "timing_ready",
                          "redundancy_ready",
                          "placement_ready",
                          "nodes_available",
                          "hops_ready",
                          "format_compatible",
                          "media_flowing"
                        ]
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "status": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "true",
                          "false",
                          "unknown"
                        ]
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "not_requested",
                          "timed_delivery_unsupported",
                          "latency_budget_infeasible",
                          "clock_unavailable",
                          "timing_calibrating",
                          "timing_ready",
                          "timing_degraded",
                          "redundancy_ready",
                          "redundancy_degraded",
                          "placed",
                          "single_path",
                          "disabled",
                          "placement_failed",
                          "cleartext_not_allowed",
                          "nodes_available",
                          "node_missing",
                          "node_offline",
                          "input_missing",
                          "output_missing",
                          "hops_ready",
                          "hops_pending",
                          "hop_failed",
                          "format_compatible",
                          "source_format_unknown",
                          "destination_accepts_unknown",
                          "hop_accepts_unknown",
                          "media_behavior_unknown",
                          "format_route_unknown",
                          "format_mismatch",
                          "media_flowing",
                          "awaiting_input",
                          "media_degraded",
                          "media_failed",
                          "media_idle",
                          "not_ready"
                        ]
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "detail": {
                    "type": "string"
                  },
                  "last_transition_time": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "type",
                  "status",
                  "reason",
                  "detail",
                  "last_transition_time"
                ]
              }
            },
            "destinations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "status": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "idle",
                          "failed",
                          "pending",
                          "awaiting_input",
                          "degraded",
                          "flowing"
                        ]
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "conditions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "timing_ready",
                                "redundancy_ready",
                                "placement_ready",
                                "nodes_available",
                                "hops_ready",
                                "format_compatible",
                                "media_flowing"
                              ]
                            },
                            {
                              "type": "string"
                            }
                          ]
                        },
                        "status": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "true",
                                "false",
                                "unknown"
                              ]
                            },
                            {
                              "type": "string"
                            }
                          ]
                        },
                        "reason": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "not_requested",
                                "timed_delivery_unsupported",
                                "latency_budget_infeasible",
                                "clock_unavailable",
                                "timing_calibrating",
                                "timing_ready",
                                "timing_degraded",
                                "redundancy_ready",
                                "redundancy_degraded",
                                "placed",
                                "single_path",
                                "disabled",
                                "placement_failed",
                                "cleartext_not_allowed",
                                "nodes_available",
                                "node_missing",
                                "node_offline",
                                "input_missing",
                                "output_missing",
                                "hops_ready",
                                "hops_pending",
                                "hop_failed",
                                "format_compatible",
                                "source_format_unknown",
                                "destination_accepts_unknown",
                                "hop_accepts_unknown",
                                "media_behavior_unknown",
                                "format_route_unknown",
                                "format_mismatch",
                                "media_flowing",
                                "awaiting_input",
                                "media_degraded",
                                "media_failed",
                                "media_idle",
                                "not_ready"
                              ]
                            },
                            {
                              "type": "string"
                            }
                          ]
                        },
                        "detail": {
                          "type": "string"
                        },
                        "last_transition_time": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "type",
                        "status",
                        "reason",
                        "detail",
                        "last_transition_time"
                      ]
                    }
                  }
                },
                "required": [
                  "id",
                  "status",
                  "conditions"
                ]
              }
            }
          },
          "required": [
            "format_policy",
            "name",
            "generation",
            "observed_generation",
            "status",
            "conditions",
            "destinations"
          ]
        }
      },
      "required": [
        "stream"
      ]
    },
    {
      "type": "object"
    }
  ]
}
