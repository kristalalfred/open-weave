{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StreamSetAccepted",
  "type": "object",
  "properties": {
    "status": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "accepted"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "changed": {
      "type": "boolean"
    },
    "streams": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "generation": {
            "type": "integer",
            "format": "uint64",
            "minimum": 1
          },
          "action": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "created",
                  "updated",
                  "unchanged"
                ]
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "name",
          "generation",
          "action"
        ]
      }
    },
    "pruned": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63,
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
      }
    }
  },
  "required": [
    "status",
    "owner",
    "changed",
    "streams",
    "pruned"
  ]
}
