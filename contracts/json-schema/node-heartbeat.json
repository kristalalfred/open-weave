{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NodeHeartbeat",
  "type": "object",
  "properties": {
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "status": {
      "type": "string",
      "enum": [
        "unknown",
        "ready",
        "degraded",
        "offline"
      ]
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "node_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "source",
              "destination",
              "bidirectional",
              "flow",
              "gateway",
              "unknown"
            ]
          },
          "transports": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "metadata": {
            "default": null
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind"
        ]
      },
      "default": []
    },
    "hop_status": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "provisioned",
              "failed"
            ]
          },
          "ingress": {
            "type": "object",
            "properties": {
              "condition": {
                "type": "string",
                "enum": [
                  "idle",
                  "connecting",
                  "connected",
                  "flowing",
                  "stalled"
                ],
                "default": "idle"
              },
              "resolved": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer",
                    "format": "uint16",
                    "minimum": 0,
                    "maximum": 65535
                  }
                },
                "additionalProperties": false,
                "required": [
                  "host",
                  "port"
                ]
              },
              "stats": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "connections": {
                    "type": "integer",
                    "format": "uint",
                    "minimum": 0,
                    "default": 0
                  },
                  "rate_mbps": {
                    "type": "number",
                    "format": "double",
                    "default": 0.0
                  },
                  "packets_sent_lost": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_retransmitted": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_received_lost": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_received_retransmitted": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "merge_ingress": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "condition": {
                "type": "string",
                "enum": [
                  "idle",
                  "connecting",
                  "connected",
                  "flowing",
                  "stalled"
                ],
                "default": "idle"
              },
              "resolved": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer",
                    "format": "uint16",
                    "minimum": 0,
                    "maximum": 65535
                  }
                },
                "additionalProperties": false,
                "required": [
                  "host",
                  "port"
                ]
              },
              "stats": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "connections": {
                    "type": "integer",
                    "format": "uint",
                    "minimum": 0,
                    "default": 0
                  },
                  "rate_mbps": {
                    "type": "number",
                    "format": "double",
                    "default": 0.0
                  },
                  "packets_sent_lost": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_retransmitted": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_received_lost": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_received_retransmitted": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "egresses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "branch_id": {
                  "type": "string"
                },
                "condition": {
                  "type": "string",
                  "enum": [
                    "idle",
                    "connecting",
                    "connected",
                    "flowing",
                    "stalled"
                  ],
                  "default": "idle"
                },
                "resolved": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "host": {
                      "type": "string"
                    },
                    "port": {
                      "type": "integer",
                      "format": "uint16",
                      "minimum": 0,
                      "maximum": 65535
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "host",
                    "port"
                  ]
                },
                "stats": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "connections": {
                      "type": "integer",
                      "format": "uint",
                      "minimum": 0,
                      "default": 0
                    },
                    "rate_mbps": {
                      "type": "number",
                      "format": "double",
                      "default": 0.0
                    },
                    "packets_sent_lost": {
                      "type": "integer",
                      "format": "int64",
                      "default": 0
                    },
                    "packets_retransmitted": {
                      "type": "integer",
                      "format": "int64",
                      "default": 0
                    },
                    "packets_received_lost": {
                      "type": "integer",
                      "format": "int64",
                      "default": 0
                    },
                    "packets_received_retransmitted": {
                      "type": "integer",
                      "format": "int64",
                      "default": 0
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false,
              "required": [
                "branch_id"
              ]
            },
            "default": []
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "node_id",
          "state",
          "ingress"
        ]
      },
      "default": []
    }
  },
  "additionalProperties": false,
  "required": [
    "node_id",
    "status"
  ]
}
