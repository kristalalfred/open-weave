{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NodeHeartbeat",
  "type": "object",
  "properties": {
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "status": {
      "type": "string",
      "enum": [
        "unknown",
        "ready",
        "degraded",
        "offline"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "label": {
            "type": "string"
          },
          "tracks": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "audio",
                "video"
              ]
            },
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "tracks"
        ]
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ]
      }
    },
    "observation": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "uplink": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "interface": {
              "type": "string"
            },
            "address": {
              "type": "string",
              "format": "ipv4"
            },
            "prefix_len": {
              "type": "integer",
              "format": "uint8",
              "minimum": 0,
              "maximum": 32
            },
            "gateway": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"
            },
            "reflexive": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "server": {
                    "type": "string"
                  },
                  "mapped": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "server",
                  "mapped"
                ]
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "required": [
            "interface",
            "address",
            "prefix_len"
          ]
        }
      },
      "additionalProperties": false
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "node_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "source",
              "destination",
              "bidirectional",
              "flow",
              "gateway",
              "unknown"
            ]
          },
          "transports": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "metadata": {
            "default": null
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind"
        ]
      },
      "default": []
    },
    "hop_status": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "provisioned",
              "failed"
            ]
          },
          "ingress": {
            "type": "object",
            "properties": {
              "condition": {
                "type": "string",
                "enum": [
                  "idle",
                  "connecting",
                  "connected",
                  "flowing",
                  "stalled"
                ],
                "default": "idle"
              },
              "resolved": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer",
                    "format": "uint16",
                    "minimum": 0,
                    "maximum": 65535
                  }
                },
                "additionalProperties": false,
                "required": [
                  "host",
                  "port"
                ]
              },
              "stats": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "connections": {
                    "type": "integer",
                    "format": "uint",
                    "minimum": 0,
                    "default": 0
                  },
                  "rate_mbps": {
                    "type": "number",
                    "format": "double",
                    "default": 0.0
                  },
                  "packets_sent_lost": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_retransmitted": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_received_lost": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_received_retransmitted": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "merge_ingress": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "condition": {
                "type": "string",
                "enum": [
                  "idle",
                  "connecting",
                  "connected",
                  "flowing",
                  "stalled"
                ],
                "default": "idle"
              },
              "resolved": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer",
                    "format": "uint16",
                    "minimum": 0,
                    "maximum": 65535
                  }
                },
                "additionalProperties": false,
                "required": [
                  "host",
                  "port"
                ]
              },
              "stats": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "connections": {
                    "type": "integer",
                    "format": "uint",
                    "minimum": 0,
                    "default": 0
                  },
                  "rate_mbps": {
                    "type": "number",
                    "format": "double",
                    "default": 0.0
                  },
                  "packets_sent_lost": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_retransmitted": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_received_lost": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_received_retransmitted": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "egresses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "branch_id": {
                  "type": "string"
                },
                "condition": {
                  "type": "string",
                  "enum": [
                    "idle",
                    "connecting",
                    "connected",
                    "flowing",
                    "stalled"
                  ],
                  "default": "idle"
                },
                "resolved": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "host": {
                      "type": "string"
                    },
                    "port": {
                      "type": "integer",
                      "format": "uint16",
                      "minimum": 0,
                      "maximum": 65535
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "host",
                    "port"
                  ]
                },
                "stats": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "connections": {
                      "type": "integer",
                      "format": "uint",
                      "minimum": 0,
                      "default": 0
                    },
                    "rate_mbps": {
                      "type": "number",
                      "format": "double",
                      "default": 0.0
                    },
                    "packets_sent_lost": {
                      "type": "integer",
                      "format": "int64",
                      "default": 0
                    },
                    "packets_retransmitted": {
                      "type": "integer",
                      "format": "int64",
                      "default": 0
                    },
                    "packets_received_lost": {
                      "type": "integer",
                      "format": "int64",
                      "default": 0
                    },
                    "packets_received_retransmitted": {
                      "type": "integer",
                      "format": "int64",
                      "default": 0
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false,
              "required": [
                "branch_id"
              ]
            },
            "default": []
          },
          "delivery": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "awaiting_input",
                  "calibrating",
                  "ready",
                  "degraded",
                  "failed"
                ]
              },
              "reason": {
                "type": "string",
                "enum": [
                  "awaiting_input",
                  "calibrating",
                  "timely",
                  "single_path",
                  "clock_unavailable",
                  "clock_uncertainty_exceeded",
                  "clock_discontinuity",
                  "deadline_missed",
                  "scheduling_violation",
                  "record_conflict",
                  "output_unavailable",
                  "output_backpressure",
                  "buffer_exhausted",
                  "latency_budget_infeasible"
                ]
              },
              "selected_latency_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint32",
                "minimum": 0
              },
              "timing_ready": {
                "type": "boolean"
              },
              "redundancy_ready": {
                "type": "boolean"
              },
              "clock_uncertainty_us": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint32",
                "minimum": 0
              },
              "buffer_records": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0
              },
              "buffer_bytes": {
                "type": "integer",
                "format": "uint64",
                "minimum": 0
              },
              "minimum_release_age_us": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint64",
                "minimum": 0
              },
              "maximum_release_age_us": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint64",
                "minimum": 0
              },
              "counters": {
                "type": "object",
                "properties": {
                  "released": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  },
                  "duplicates": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  },
                  "late_arrivals": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  },
                  "unrecovered": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  },
                  "scheduling_violations": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  },
                  "buffer_drops": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  },
                  "invalid_records": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  }
                },
                "additionalProperties": false,
                "required": [
                  "released",
                  "duplicates",
                  "late_arrivals",
                  "unrecovered",
                  "scheduling_violations",
                  "buffer_drops",
                  "invalid_records"
                ]
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "received": {
                      "type": "integer",
                      "format": "uint64",
                      "minimum": 0
                    },
                    "late": {
                      "type": "integer",
                      "format": "uint64",
                      "minimum": 0
                    },
                    "latest_age_us": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "format": "uint64",
                      "minimum": 0
                    },
                    "qualified": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "received",
                    "late",
                    "qualified"
                  ]
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "state",
              "reason",
              "timing_ready",
              "redundancy_ready",
              "buffer_records",
              "buffer_bytes",
              "counters",
              "paths"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "node_id",
          "revision",
          "state",
          "ingress"
        ]
      },
      "default": []
    }
  },
  "additionalProperties": false,
  "required": [
    "node_id",
    "status",
    "inputs",
    "outputs"
  ]
}
