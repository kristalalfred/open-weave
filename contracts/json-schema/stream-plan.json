                    "type": [
                      "integer",
                      "null"
                    ],
                    "format": "uint32",
                    "minimum": 0
                  },
                  "passphrase": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 10,
                    "maxLength": 80,
                    "pattern": "^[ -~]*$"
                  },
                  "pbkeylen": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "format": "uint8",
                    "minimum": 0,
                    "maximum": 255,
                    "enum": [
                      16,
                      24,
                      32
                    ]
                  }
                }
              }
            },
            "required": [
              "transport",
              "role"
            ]
          },
          "egresses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "branch_id": {
                  "type": "string"
                },
                "transport": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "srt",
                        "whip",
                        "whep",
                        "rist",
                        "device"
                      ]
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "role": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "listen",
                        "connect",
                        "capture",
                        "display"
                      ]
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "host": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "port": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "format": "uint16",
                  "minimum": 0,
                  "maximum": 65535
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "endpoint_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "params": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "latency": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "format": "uint32",
