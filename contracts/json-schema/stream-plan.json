                ]
              },
              "port": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint16",
                "minimum": 0,
                "maximum": 65535
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "endpoint_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "params": {
                "type": [
                  "object",
