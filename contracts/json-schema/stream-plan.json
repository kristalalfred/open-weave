{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StreamPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "status": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "disabled",
            "placed",
            "unplaced"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63,
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
      }
    },
    "hops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "profile_id": {
            "type": "string"
          },
          "role": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "sender",
                  "bridge",
                  "receiver"
                ]
              },
              {
                "type": "string"
              }
            ]
          },
          "ingress": {
            "type": "object",
            "properties": {
              "transport": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "srt",
                      "whip",
                      "whep",
                      "rist",
                      "device"
                    ]
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "role": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "listen",
                      "connect",
                      "capture",
                      "display"
                    ]
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "host": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "port": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint16",
                "minimum": 0,
                "maximum": 65535
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "endpoint_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "params": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "latency": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "format": "uint32",
                    "minimum": 0
                  },
                  "passphrase": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 10,
                    "maxLength": 80,
                    "pattern": "^[ -~]*$"
                  },
                  "pbkeylen": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "format": "uint8",
                    "minimum": 0,
                    "maximum": 255,
                    "enum": [
                      16,
                      24,
                      32
                    ]
                  }
                }
              }
            },
            "required": [
              "transport",
              "role"
            ]
          },
          "merge_ingress": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "transport": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
