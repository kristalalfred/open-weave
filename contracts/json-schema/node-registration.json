{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NodeRegistration",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "default": 0
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "endpoint": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "unknown",
            "ready",
            "degraded",
            "offline"
          ]
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "adapters": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "strom",
                      "nmos",
                      "mxl_domain",
                      "mxl_k8s",
                      "mcm",
                      "vendor",
                      "custom"
                    ]
                  }
                },
                "additionalProperties": false,
                "required": [
                  "name",
                  "kind"
                ]
              },
              "default": []
            },
            "hop_profiles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "media_behavior": {
                    "type": "string",
                    "enum": [
                      "preserve",
                      "unknown"
                    ],
                    "default": "unknown"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63,
                    "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
                  },
                  "ingress": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "transport": {
                            "type": "string",
                            "enum": [
                              "srt",
                              "whip",
                              "whep",
                              "rist"
                            ]
                          },
                          "roles": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "listen",
                                "connect"
                              ]
                            },
                            "minItems": 1
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "transport",
                          "roles"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "device": {
                            "type": "string",
                            "enum": [
                              "capture",
                              "display"
                            ]
                          },
                          "tracks": {
                            "type": [
                              "array",
                              "null"
                            ],
                            "items": {
                              "type": "string",
                              "enum": [
                                "audio",
                                "video"
                              ]
                            }
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "device"
                        ]
                      }
                    ]
                  },
                  "egress": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "transport": {
                            "type": "string",
                            "enum": [
                              "srt",
                              "whip",
                              "whep",
                              "rist"
                            ]
                          },
                          "roles": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "listen",
                                "connect"
                              ]
                            },
                            "minItems": 1
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "transport",
                          "roles"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "device": {
                            "type": "string",
                            "enum": [
                              "capture",
                              "display"
                            ]
                          },
                          "tracks": {
                            "type": [
                              "array",
                              "null"
                            ],
                            "items": {
                              "type": "string",
                              "enum": [
                                "audio",
                                "video"
                              ]
                            }
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "device"
                        ]
                      }
                    ]
                  },
                  "max_egresses": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "format": "uint",
                    "minimum": 1
                  },
                  "merge": {
                    "type": "boolean"
                  },
                  "accepts": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "properties": {
                      "container": {
                        "type": [
                          "array",
                          "null"
                        ],
                        "items": {
                          "type": "string",
                          "enum": [
                            "mpeg_ts",
                            "rtp"
                          ]
                        },
                        "minItems": 1
                      },
                      "video": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "properties": {
                          "codec": {
                            "type": [
                              "array",
                              "null"
                            ],
                            "items": {
                              "type": "string",
                              "enum": [
                                "h264",
                                "h265",
                                "av1",
                                "vp8",
                                "vp9"
                              ]
                            },
                            "minItems": 1
                          },
                          "width": {
                            "type": [
                              "array",
                              "null"
                            ],
                            "items": {
                              "type": "integer",
                              "format": "uint32",
                              "minimum": 0
                            },
                            "minItems": 1
                          },
                          "height": {
                            "type": [
                              "array",
                              "null"
                            ],
                            "items": {
                              "type": "integer",
                              "format": "uint32",
                              "minimum": 0
                            },
                            "minItems": 1
                          },
                          "framerate": {
                            "type": [
                              "array",
                              "null"
                            ],
                            "items": {
                              "type": "object",
                              "properties": {
                                "numerator": {
                                  "type": "integer",
                                  "format": "uint32",
                                  "minimum": 0
                                },
                                "denominator": {
                                  "type": "integer",
                                  "format": "uint32",
                                  "minimum": 0
                                }
                              },
                              "additionalProperties": false,
                              "required": [
                                "numerator",
                                "denominator"
                              ]
                            },
                            "minItems": 1
                          },
                          "chroma_subsampling": {
                            "type": [
                              "array",
                              "null"
                            ],
                            "items": {
                              "type": "string",
                              "enum": [
                                "yuv420",
                                "yuv422",
                                "yuv444"
                              ]
                            },
                            "minItems": 1
                          }
                        },
                        "additionalProperties": false
                      },
                      "audio": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "properties": {
                          "codec": {
                            "type": [
                              "array",
                              "null"
                            ],
                            "items": {
                              "type": "string",
                              "enum": [
                                "aac",
                                "opus",
                                "mp2",
                                "pcm_s16",
                                "pcm_s24"
                              ]
                            },
                            "minItems": 1
                          },
                          "sample_rate": {
                            "type": [
                              "array",
                              "null"
                            ],
                            "items": {
                              "type": "integer",
                              "format": "uint32",
                              "minimum": 0
                            },
                            "minItems": 1
                          },
                          "channels": {
                            "type": [
                              "array",
                              "null"
                            ],
                            "items": {
                              "type": "integer",
                              "format": "uint8",
                              "minimum": 0,
                              "maximum": 255
                            },
                            "minItems": 1
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false,
                "required": [
                  "id",
                  "ingress",
                  "egress"
                ]
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {
            "adapters": [],
            "hop_profiles": []
          }
        },
        "topology": {
          "type": "object",
          "properties": {
            "attachments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63,
                    "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
                  },
                  "network": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63,
                    "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
                  },
                  "dial": {
                    "type": "boolean",
                    "default": false
                  },
                  "listeners": {
                    "type": "object",
                    "properties": {
                      "srt": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "properties": {
                          "host": {
                            "type": "string"
                          },
                          "port_range": {
                            "type": "object",
                            "properties": {
                              "start": {
                                "type": "integer",
                                "format": "uint16",
                                "minimum": 0,
                                "maximum": 65535
                              },
                              "end": {
                                "type": "integer",
                                "format": "uint16",
                                "minimum": 0,
                                "maximum": 65535
                              }
                            },
                            "additionalProperties": false,
                            "required": [
                              "start",
                              "end"
                            ]
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "host",
                          "port_range"
                        ]
                      },
                      "whip": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "properties": {
                          "base_url": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "base_url"
                        ]
                      },
                      "whep": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "properties": {
                          "base_url": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "base_url"
                        ]
                      },
                      "rist": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "properties": {
                          "host": {
                            "type": "string"
                          },
                          "port_range": {
                            "type": "object",
                            "properties": {
                              "start": {
                                "type": "integer",
                                "format": "uint16",
                                "minimum": 0,
                                "maximum": 65535
                              },
                              "end": {
                                "type": "integer",
                                "format": "uint16",
                                "minimum": 0,
                                "maximum": 65535
                              }
                            },
                            "additionalProperties": false,
                            "required": [
                              "start",
                              "end"
                            ]
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "host",
                          "port_range"
                        ]
                      }
                    },
                    "additionalProperties": false,
                    "default": {}
                  }
                },
                "additionalProperties": false,
                "required": [
                  "id",
                  "network"
                ]
              },
              "default": []
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "endpoint",
        "status",
        "topology"
      ]
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "node_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "source",
              "destination",
              "bidirectional",
              "flow",
              "gateway",
              "unknown"
            ]
          },
          "transports": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "metadata": {
            "default": null
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind"
        ]
      },
      "default": []
    },
    "hop_status": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "provisioned",
              "failed"
            ]
          },
          "ingress": {
            "type": "object",
            "properties": {
              "condition": {
                "type": "string",
                "enum": [
                  "idle",
                  "connecting",
                  "connected",
                  "flowing",
                  "stalled"
                ],
                "default": "idle"
              },
              "resolved": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer",
                    "format": "uint16",
                    "minimum": 0,
                    "maximum": 65535
                  }
                },
                "additionalProperties": false,
                "required": [
                  "host",
                  "port"
                ]
              },
              "stats": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "connections": {
                    "type": "integer",
                    "format": "uint",
                    "minimum": 0,
                    "default": 0
                  },
                  "rate_mbps": {
                    "type": "number",
                    "format": "double",
                    "default": 0.0
                  },
                  "packets_sent_lost": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_retransmitted": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_received_lost": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_received_retransmitted": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "merge_ingress": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "condition": {
                "type": "string",
                "enum": [
                  "idle",
                  "connecting",
                  "connected",
                  "flowing",
                  "stalled"
                ],
                "default": "idle"
              },
              "resolved": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer",
                    "format": "uint16",
                    "minimum": 0,
                    "maximum": 65535
                  }
                },
                "additionalProperties": false,
                "required": [
                  "host",
                  "port"
                ]
              },
              "stats": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "connections": {
                    "type": "integer",
                    "format": "uint",
                    "minimum": 0,
                    "default": 0
                  },
                  "rate_mbps": {
                    "type": "number",
                    "format": "double",
                    "default": 0.0
                  },
                  "packets_sent_lost": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_retransmitted": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_received_lost": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_received_retransmitted": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "egresses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "branch_id": {
                  "type": "string"
                },
                "condition": {
                  "type": "string",
                  "enum": [
                    "idle",
                    "connecting",
                    "connected",
                    "flowing",
                    "stalled"
                  ],
                  "default": "idle"
                },
                "resolved": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "host": {
                      "type": "string"
                    },
                    "port": {
                      "type": "integer",
                      "format": "uint16",
                      "minimum": 0,
                      "maximum": 65535
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "host",
                    "port"
                  ]
                },
                "stats": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "connections": {
                      "type": "integer",
                      "format": "uint",
                      "minimum": 0,
                      "default": 0
                    },
                    "rate_mbps": {
                      "type": "number",
                      "format": "double",
                      "default": 0.0
                    },
                    "packets_sent_lost": {
                      "type": "integer",
                      "format": "int64",
                      "default": 0
                    },
                    "packets_retransmitted": {
                      "type": "integer",
                      "format": "int64",
                      "default": 0
                    },
                    "packets_received_lost": {
                      "type": "integer",
                      "format": "int64",
                      "default": 0
                    },
                    "packets_received_retransmitted": {
                      "type": "integer",
                      "format": "int64",
                      "default": 0
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false,
              "required": [
                "branch_id"
              ]
            },
            "default": []
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "node_id",
          "state",
          "ingress"
        ]
      },
      "default": []
    }
  },
  "additionalProperties": false,
  "required": [
    "node"
  ]
}
