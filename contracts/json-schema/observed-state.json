{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObservedState",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "endpoint": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "unknown",
              "ready",
              "degraded",
              "offline"
            ]
          },
          "capabilities": {
            "type": "object",
            "properties": {
              "adapters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "strom",
                        "nmos",
                        "mxl_domain",
                        "mxl_k8s",
                        "mcm",
                        "vendor",
                        "custom"
                      ]
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "kind"
                  ]
                },
                "default": []
              },
              "hop_profiles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 63,
                      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
                    },
                    "ingress": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "transport": {
                              "description": "A transport that carries media between two nodes.",
                              "oneOf": [
                                {
                                  "type": "string",
                                  "enum": [
                                    "srt"
                                  ]
                                },
                                {
                                  "description": "WebRTC ingest. The `Connect` end pushes media to the `Listen` end's\n signalling URL.",
                                  "type": "string",
                                  "const": "whip"
                                },
                                {
                                  "description": "WebRTC playback. The `Connect` end pulls media from the `Listen` end's\n signalling URL.",
                                  "type": "string",
                                  "const": "whep"
                                },
                                {
                                  "description": "RIST simple profile. The `Connect` end pushes to the `Listen` end.",
                                  "type": "string",
                                  "const": "rist"
                                }
                              ]
                            },
                            "roles": {
                              "type": "array",
                              "items": {
                                "description": "Which end of a link a socket is: `Listen` hosts and `Connect` dials.",
                                "type": "string",
                                "enum": [
                                  "listen",
                                  "connect"
                                ]
                              },
                              "minItems": 1
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "transport",
                            "roles"
                          ]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "device": {
                              "description": "The node's own capture or display device, where media starts or ends.",
                              "type": "string",
                              "enum": [
                                "capture",
                                "display"
                              ]
                            },
                            "tracks": {
                              "description": "The tracks a capture device sends. Absent means unknown.",
                              "type": [
                                "array",
                                "null"
                              ],
                              "items": {
                                "description": "A kind of media track a capture device sends.",
                                "type": "string",
                                "enum": [
                                  "audio",
                                  "video"
                                ]
                              }
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "device"
                          ]
                        }
                      ]
                    },
                    "egress": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "transport": {
                              "description": "A transport that carries media between two nodes.",
                              "oneOf": [
                                {
                                  "type": "string",
                                  "enum": [
                                    "srt"
                                  ]
                                },
                                {
                                  "description": "WebRTC ingest. The `Connect` end pushes media to the `Listen` end's\n signalling URL.",
                                  "type": "string",
                                  "const": "whip"
                                },
                                {
                                  "description": "WebRTC playback. The `Connect` end pulls media from the `Listen` end's\n signalling URL.",
                                  "type": "string",
                                  "const": "whep"
                                },
                                {
                                  "description": "RIST simple profile. The `Connect` end pushes to the `Listen` end.",
                                  "type": "string",
                                  "const": "rist"
                                }
                              ]
                            },
                            "roles": {
                              "type": "array",
                              "items": {
                                "description": "Which end of a link a socket is: `Listen` hosts and `Connect` dials.",
                                "type": "string",
                                "enum": [
                                  "listen",
                                  "connect"
                                ]
                              },
                              "minItems": 1
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "transport",
                            "roles"
                          ]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "device": {
                              "description": "The node's own capture or display device, where media starts or ends.",
                              "type": "string",
                              "enum": [
                                "capture",
                                "display"
                              ]
                            },
                            "tracks": {
                              "description": "The tracks a capture device sends. Absent means unknown.",
                              "type": [
                                "array",
                                "null"
                              ],
                              "items": {
                                "description": "A kind of media track a capture device sends.",
                                "type": "string",
                                "enum": [
                                  "audio",
                                  "video"
                                ]
                              }
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "device"
                          ]
                        }
                      ]
                    },
                    "max_egresses": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "format": "uint",
                      "minimum": 1
                    },
                    "merge": {
                      "description": "The hop can take a second ingress of the `ingress` class carrying another\n copy of the same media, and merge the two.",
                      "type": "boolean"
                    },
                    "accepts": {
                      "description": "The media this profile's ingress takes. Absent takes anything. A\n source `format` it does not accept is reported as a format mismatch.",
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "container": {
                          "type": [
                            "array",
                            "null"
                          ],
                          "items": {
                            "type": "string",
                            "enum": [
                              "mpeg_ts",
                              "rtp"
                            ]
                          },
                          "minItems": 1
                        },
                        "video": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "properties": {
                            "codec": {
                              "type": [
                                "array",
                                "null"
                              ],
                              "items": {
                                "type": "string",
                                "enum": [
                                  "h264",
                                  "h265",
                                  "av1",
                                  "vp8",
                                  "vp9"
                                ]
                              },
                              "minItems": 1
                            },
                            "width": {
                              "type": [
                                "array",
                                "null"
                              ],
                              "items": {
                                "type": "integer",
                                "format": "uint32",
                                "minimum": 0
                              },
                              "minItems": 1
                            },
                            "height": {
                              "type": [
                                "array",
                                "null"
                              ],
                              "items": {
                                "type": "integer",
                                "format": "uint32",
                                "minimum": 0
                              },
                              "minItems": 1
                            },
                            "framerate": {
                              "type": [
                                "array",
                                "null"
                              ],
                              "items": {
                                "description": "Frames per second as a rational, because broadcast rates are not integers:\n 29.97 is exactly 30000/1001 and rounding it loses the distinction from 30.",
                                "type": "object",
                                "properties": {
                                  "numerator": {
                                    "type": "integer",
                                    "format": "uint32",
                                    "minimum": 0
                                  },
                                  "denominator": {
                                    "type": "integer",
                                    "format": "uint32",
                                    "minimum": 0
                                  }
                                },
                                "additionalProperties": false,
                                "required": [
                                  "numerator",
                                  "denominator"
                                ]
                              },
                              "minItems": 1
                            },
                            "chroma_subsampling": {
                              "type": [
                                "array",
                                "null"
                              ],
                              "items": {
                                "type": "string",
                                "enum": [
                                  "yuv420",
                                  "yuv422",
                                  "yuv444"
                                ]
                              },
                              "minItems": 1
                            }
                          },
                          "additionalProperties": false
                        },
                        "audio": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "properties": {
                            "codec": {
                              "type": [
                                "array",
                                "null"
                              ],
                              "items": {
                                "type": "string",
                                "enum": [
                                  "aac",
                                  "opus",
                                  "mp2",
                                  "pcm_s16",
                                  "pcm_s24"
                                ]
                              },
                              "minItems": 1
                            },
                            "sample_rate": {
                              "type": [
                                "array",
                                "null"
                              ],
                              "items": {
                                "type": "integer",
                                "format": "uint32",
                                "minimum": 0
                              },
                              "minItems": 1
                            },
                            "channels": {
                              "type": [
                                "array",
                                "null"
                              ],
                              "items": {
                                "type": "integer",
                                "format": "uint8",
                                "minimum": 0,
                                "maximum": 255
                              },
                              "minItems": 1
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "ingress",
                    "egress"
                  ]
                },
                "default": []
              }
            },
            "additionalProperties": false,
            "required": [
              "adapters",
              "hop_profiles"
            ],
            "default": {
              "adapters": [],
              "hop_profiles": []
            }
          },
          "topology": {
            "type": "object",
            "properties": {
              "attachments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 63,
                      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
                    },
                    "network": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 63,
                      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
                    },
                    "dial": {
                      "type": "boolean",
                      "default": false
                    },
                    "listeners": {
                      "type": "object",
                      "properties": {
                        "srt": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "properties": {
                            "host": {
                              "type": "string"
                            },
                            "port_range": {
                              "description": "Inclusive `[start, end]` range of ports a node offers for controller-side\n assignment.",
                              "type": "object",
                              "properties": {
                                "start": {
                                  "type": "integer",
                                  "format": "uint16",
                                  "minimum": 0,
                                  "maximum": 65535
                                },
                                "end": {
                                  "type": "integer",
                                  "format": "uint16",
                                  "minimum": 0,
                                  "maximum": 65535
                                }
                              },
                              "additionalProperties": false,
                              "required": [
                                "start",
                                "end"
                              ]
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "host",
                            "port_range"
                          ]
                        },
                        "whip": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "properties": {
                            "base_url": {
                              "type": "string"
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "base_url"
                          ]
                        },
                        "whep": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "properties": {
                            "base_url": {
                              "type": "string"
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "base_url"
                          ]
                        },
                        "rist": {
                          "description": "Each RIST link takes an even port from `port_range` and the one after it.",
                          "type": [
                            "object",
                            "null"
                          ],
                          "properties": {
                            "host": {
                              "type": "string"
                            },
                            "port_range": {
                              "description": "Inclusive `[start, end]` range of ports a node offers for controller-side\n assignment.",
                              "type": "object",
                              "properties": {
                                "start": {
                                  "type": "integer",
                                  "format": "uint16",
                                  "minimum": 0,
                                  "maximum": 65535
                                },
                                "end": {
                                  "type": "integer",
                                  "format": "uint16",
                                  "minimum": 0,
                                  "maximum": 65535
                                }
                              },
                              "additionalProperties": false,
                              "required": [
                                "start",
                                "end"
                              ]
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "host",
                            "port_range"
                          ]
                        }
                      },
                      "additionalProperties": false,
                      "default": {}
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "network",
                    "dial",
                    "listeners"
                  ]
                },
                "default": []
              }
            },
            "additionalProperties": false,
            "required": [
              "attachments"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "endpoint",
          "status",
          "capabilities",
          "topology"
        ]
      },
      "default": []
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "node_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "source",
              "destination",
              "bidirectional",
              "flow",
              "gateway",
              "unknown"
            ]
          },
          "transports": {
            "description": "Transport labels an adapter recognised on this endpoint, such as\n `webrtc` or `ndi`. Guesses read off the underlying system, not offers.",
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "metadata": {
            "default": null
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "node_id",
          "kind",
          "transports",
          "metadata"
        ]
      },
      "default": []
    },
    "hops": {
      "type": "array",
      "items": {
        "description": "Node-reported realisation status for one desired hop.",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "state": {
            "description": "Control-plane lifecycle of a hop's provisioning. Runtime link health is\n reported separately per socket via [`LinkCondition`].",
            "type": "string",
            "enum": [
              "pending",
              "provisioned",
              "failed"
            ]
          },
          "ingress": {
            "description": "Observed condition, address, and statistics for one socket.",
            "type": "object",
            "properties": {
              "condition": {
                "description": "Observed condition of one socket on a hop, independent of control-plane lifecycle.",
                "oneOf": [
                  {
                    "description": "No connection; the socket is a listener patiently waiting. Healthy.",
                    "type": "string",
                    "const": "idle"
                  },
                  {
                    "description": "No connection; the socket is a caller still retrying. Ambiguous, not degraded.",
                    "type": "string",
                    "const": "connecting"
                  },
                  {
                    "description": "Connection up but rate ~0 — fine on our end, nothing coming through yet.",
                    "type": "string",
                    "const": "connected"
                  },
                  {
                    "description": "Connection up and media flowing.",
                    "type": "string",
                    "const": "flowing"
                  },
                  {
                    "description": "Ingress once carried media but byte progress has frozen while the flow still\n claims to run — detected across polls, not from any instantaneous field.",
                    "type": "string",
                    "const": "stalled"
                  }
                ],
                "default": "idle"
              },
              "resolved": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer",
                    "format": "uint16",
                    "minimum": 0,
                    "maximum": 65535
                  }
                },
                "additionalProperties": false,
                "required": [
                  "host",
                  "port"
                ]
              },
              "stats": {
                "description": "Socket-level SRT stats mirrored from Strom's `srt-stats` payload.",
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "connections": {
                    "type": "integer",
                    "format": "uint",
                    "minimum": 0,
                    "default": 0
                  },
                  "rate_mbps": {
                    "type": "number",
                    "format": "double",
                    "default": 0.0
                  },
                  "packets_sent_lost": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_retransmitted": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_received_lost": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_received_retransmitted": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  }
                },
                "additionalProperties": false,
                "required": [
                  "connections",
                  "rate_mbps",
                  "packets_sent_lost",
                  "packets_retransmitted",
                  "packets_received_lost",
                  "packets_received_retransmitted"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "condition"
            ]
          },
          "merge_ingress": {
            "description": "Observed condition, address, and statistics for one socket.",
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "condition": {
                "description": "Observed condition of one socket on a hop, independent of control-plane lifecycle.",
                "oneOf": [
                  {
                    "description": "No connection; the socket is a listener patiently waiting. Healthy.",
                    "type": "string",
                    "const": "idle"
                  },
                  {
                    "description": "No connection; the socket is a caller still retrying. Ambiguous, not degraded.",
                    "type": "string",
                    "const": "connecting"
                  },
                  {
                    "description": "Connection up but rate ~0 — fine on our end, nothing coming through yet.",
                    "type": "string",
                    "const": "connected"
                  },
                  {
                    "description": "Connection up and media flowing.",
                    "type": "string",
                    "const": "flowing"
                  },
                  {
                    "description": "Ingress once carried media but byte progress has frozen while the flow still\n claims to run — detected across polls, not from any instantaneous field.",
                    "type": "string",
                    "const": "stalled"
                  }
                ],
                "default": "idle"
              },
              "resolved": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer",
                    "format": "uint16",
                    "minimum": 0,
                    "maximum": 65535
                  }
                },
                "additionalProperties": false,
                "required": [
                  "host",
                  "port"
                ]
              },
              "stats": {
                "description": "Socket-level SRT stats mirrored from Strom's `srt-stats` payload.",
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "connections": {
                    "type": "integer",
                    "format": "uint",
                    "minimum": 0,
                    "default": 0
                  },
                  "rate_mbps": {
                    "type": "number",
                    "format": "double",
                    "default": 0.0
                  },
                  "packets_sent_lost": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_retransmitted": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_received_lost": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  },
                  "packets_received_retransmitted": {
                    "type": "integer",
                    "format": "int64",
                    "default": 0
                  }
                },
                "additionalProperties": false,
                "required": [
                  "connections",
                  "rate_mbps",
                  "packets_sent_lost",
                  "packets_retransmitted",
                  "packets_received_lost",
                  "packets_received_retransmitted"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "condition"
            ]
          },
          "egresses": {
            "type": "array",
            "items": {
              "description": "Observed status for one identified egress branch.",
              "type": "object",
              "properties": {
                "branch_id": {
                  "type": "string"
                },
                "condition": {
                  "description": "Observed condition of one socket on a hop, independent of control-plane lifecycle.",
                  "oneOf": [
                    {
                      "description": "No connection; the socket is a listener patiently waiting. Healthy.",
                      "type": "string",
                      "const": "idle"
                    },
                    {
                      "description": "No connection; the socket is a caller still retrying. Ambiguous, not degraded.",
                      "type": "string",
                      "const": "connecting"
                    },
                    {
                      "description": "Connection up but rate ~0 — fine on our end, nothing coming through yet.",
                      "type": "string",
                      "const": "connected"
                    },
                    {
                      "description": "Connection up and media flowing.",
                      "type": "string",
                      "const": "flowing"
                    },
                    {
                      "description": "Ingress once carried media but byte progress has frozen while the flow still\n claims to run — detected across polls, not from any instantaneous field.",
                      "type": "string",
                      "const": "stalled"
                    }
                  ],
                  "default": "idle"
                },
                "resolved": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "host": {
                      "type": "string"
                    },
                    "port": {
                      "type": "integer",
                      "format": "uint16",
                      "minimum": 0,
                      "maximum": 65535
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "host",
                    "port"
                  ]
                },
                "stats": {
                  "description": "Socket-level SRT stats mirrored from Strom's `srt-stats` payload.",
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "connections": {
                      "type": "integer",
                      "format": "uint",
                      "minimum": 0,
                      "default": 0
                    },
                    "rate_mbps": {
                      "type": "number",
                      "format": "double",
                      "default": 0.0
                    },
                    "packets_sent_lost": {
                      "type": "integer",
