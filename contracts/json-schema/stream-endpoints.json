{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StreamEndpoints",
  "type": "object",
  "properties": {
    "ingress": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "node": {
          "type": "string"
        },
        "host": {
          "type": [
            "string",
            "null"
          ]
        },
        "port": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "node",
        "url"
      ]
    },
    "destinations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "endpoint": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "node": {
                "type": "string"
              },
              "host": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "port": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint16",
                "minimum": 0,
                "maximum": 65535
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "node",
              "url"
            ]
          }
        },
        "required": [
          "id",
          "endpoint"
        ]
      }
    }
  },
  "required": [
    "ingress",
    "destinations"
  ]
}
