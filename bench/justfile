[doc("Serve the spaghetti node installer to the LAN and print the command that installs node <id>; give <srt_host> for a node that accepts SRT calls.")]
[group("spaghetti")]
spaghetti-node id srt_host="" network="office" port="29097":
    #!/usr/bin/env bash
    set -euo pipefail
    iface="$(route -n get default | awk '/interface:/ { print $2 }')"
    lan="$(ipconfig getifaddr "$iface" || true)"
    [ -n "$lan" ] || { echo "no LAN address on $iface" >&2; exit 1; }
    daemon="$(command -v spaghettid)" || { echo "spaghettid is not on PATH; install spaghetti first" >&2; exit 1; }
    launchctl plist __TEXT,__info_plist "$daemon" 2>/dev/null | grep -q NSLocalNetworkUsageDescription \
        || { echo "$daemon cannot ask for Local Network access; reinstall spaghetti" >&2; exit 1; }
    cargo build --release --quiet -p weave-adapter-spaghetti
    token="$(just node-token {{id}})"
    sb_plain="{{sb_plain}}"
    dir="$(mktemp -d)"; trap 'rm -rf "$dir"' EXIT
    mkdir "$dir/node"
    cp "$daemon" "$(dirname "$daemon")/spaghetti" {{source_directory()}}/../target/release/weave-adapter-spaghetti "$dir/node/"
    codesign --force --sign - "$dir/node/spaghettid" "$dir/node/weave-adapter-spaghetti" 2>/dev/null
    COPYFILE_DISABLE=1 tar --no-mac-metadata -czf "$dir/node.tar.gz" -C "$dir/node" .
    rm -rf "$dir/node"
    sed -e "s#__BUNDLE_URL__#http://$lan:{{port}}/node.tar.gz#" \
        -e "s#__SOUTHBOUND_URL__#${sb_plain/localhost/$lan}#" \
        -e "s#__NETWORK__#{{network}}#" \
        {{source_directory()}}/../crates/adapter-spaghetti/install.sh >"$dir/install.sh"
    echo "on the Mac for {{id}}, run:"
    echo "  curl -fsSL http://$lan:{{port}}/install.sh | bash -s -- $token {{srt_host}}"
    python3 -m http.server {{port}} -d "$dir" --bind "$lan"

[doc("Apply browser-cam-host for <seat> (the id `just bench page` pinned); print its WHIP URL and SRT output.")]
[group("browser")]
host-cam seat="guest-1":
    #!/usr/bin/env bash
    set -euo pipefail
    tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
    sed "s/browser-placeholder/{{seat}}/" {{manifests}}/browser-cam-host.yaml > "$tmp"
    WEAVE_NORTHBOUND_TOKEN={{nb_token}} {{cli}} apply -f "$tmp"
    seat_auth="Authorization: Bearer $(just node-token {{seat}})"
    url=""
    for _ in $(seq 1 15); do
        url="$(curl -sf {{tls}} -H "$seat_auth" {{sb}}/nodes/{{seat}}/desired \
            | jq -r '.[] | select(.id=="weave-browser-cam-host-sender") | .egresses[0].url' 2>/dev/null || true)"
        [ -n "$url" ] && break
        sleep 2
    done
    if [ -z "$url" ]; then
        echo "browser-cam-host has no hop on {{seat}} yet — is that page registered? 'just bench status' lists nodes" >&2
        exit 1
    fi
    out="$(WEAVE_NORTHBOUND_TOKEN={{nb_token}} bash {{scripts}}/endpoints.sh browser-cam-host destination output)"
    echo "page sends WHIP to:     $url"
    echo "open-live dials:        srt://$out?mode=caller  (listed by its weave provider)"

[group("browser")]
host-cam-down:
    @just stream-rm browser-cam-host

[doc("Print the webhooks the controller delivers, until interrupted.")]
[group("webhooks")]
hook-sink:
    #!/usr/bin/env python3
    import http.server, json, sys

    class Sink(http.server.BaseHTTPRequestHandler):
        def do_POST(self):
            body = self.rfile.read(int(self.headers.get("content-length", 0)))
            auth = self.headers.get("authorization", "<none>")
            try:
                event = json.loads(body)
                subject = event["node"]["id"] if "node" in event else event["stream"]["name"]
                line = f"{event['event_type']:16} {subject:16} {event['occurred_at']}"
                detail = json.dumps(event, indent=2)
            except (ValueError, KeyError):
                line, detail = "<unparsed>", body.decode("utf-8", "replace")
            print(f"{line}\n  authorization: {auth}\n{detail}", flush=True)
            self.send_response(200)
            self.end_headers()

        def log_message(self, *_):
            pass

    print("webhook sink on http://0.0.0.0:{{hook_port}} — ctrl-c to stop", flush=True)
    try:
        http.server.HTTPServer(("0.0.0.0", {{hook_port}}), Sink).serve_forever()
    except KeyboardInterrupt:
        sys.exit(0)

