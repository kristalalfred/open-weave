        basename "$f" .yaml; \
    done

[doc("Apply a manifest by name, control plane only (no media).")]
[group("streams")]
stream name:
    @WEAVE_NORTHBOUND_TOKEN={{nb_token}} {{cli}} apply -f {{manifests}}/{{name}}.yaml
    @[ -n "${WEAVE_BENCH_DRIVING:-}" ] || \
        echo "applied {{name}} (no media yet — 'just bench stream-up {{name}}' drives it end to end)"

[doc("Apply a manifest AND drive it end to end, waiting for `flowing`.")]
[group("streams")]
stream-up name="basic":
    #!/usr/bin/env bash
    set -euo pipefail
    WEAVE_BENCH_DRIVING=1 just stream {{name}}
    for _ in $(seq 1 10); do
        placed="$(curl -sf {{tls}} {{nb_auth}} {{nb}}/status \
            | jq -r --arg n {{name}} '.streams[] | select(.name==$n) | .status' 2>/dev/null || true)"
        [ -n "$placed" ] && [ "$placed" != "pending" ] && break
        sleep 2
    done
    case "${placed:-}" in
        idle)
            echo "{{name}} is disabled (enabled: false) — no hops provisioned, nothing to drive"
            exit 0 ;;
        pending|"")
            echo "{{name}} never placed (status ${placed:-unknown}) — no node matched its hops," \
                 "so there is no ingress to feed. 'just bench status' shows registered nodes." >&2
            exit 1 ;;
    esac
    outputs="$(WEAVE_NORTHBOUND_TOKEN={{nb_token}} bash {{scripts}}/endpoints.sh {{name}} destinations)"
    ids="$(WEAVE_NORTHBOUND_TOKEN={{nb_token}} bash {{scripts}}/endpoints.sh {{name}} destination-ids)"
    first="$(printf '%s\n' "$ids" | awk '{print $1}')"
    second="$(printf '%s\n' "$ids" | awk '{print $2}')"
    echo "{{name}} placed with $outputs receiver output(s); attaching endpoints"
    spec="$(curl -sf {{tls}} {{nb_auth}} {{nb}}/streams/{{name}})"
    passphrase() { printf '%s' "$spec" | jq -r "$1 // empty"; }
    destination_passphrase() {
        passphrase ".spec.destinations[] | select(.id==\"$1\") | .srt.passphrase"
    }
    just producer-up {{name}} "$(passphrase .spec.source.srt.passphrase)"
    just consumer-up {{name}} "$first" "$(destination_passphrase "$first")"
    if [ "$outputs" -ge 2 ]; then
        just consumer-2-up {{name}} "$second" "$(destination_passphrase "$second")"
    fi
    if [ "$outputs" -gt 2 ]; then
        echo "warning: {{name}} has $outputs outputs but the bench has 2 consumers;" \
             "outputs 2+ stay unattached and the stream will report degraded" >&2
    fi
    just stream-wait {{name}} flowing

[group("streams")]
stream-down name="basic":
    -@just producer-down
    -@just consumer-down
    -@just consumer-2-down
    @just stream-rm {{name}}

[group("streams")]
stream-wait name status="flowing" attempts="45":
    #!/usr/bin/env bash
    set -euo pipefail
    for _ in $(seq 1 {{attempts}}); do
        got="$(curl -sf {{tls}} {{nb_auth}} {{nb}}/status \
            | jq -r --arg n {{name}} '.streams[] | select(.name==$n) | .status' 2>/dev/null || true)"
        if [ "$got" = "{{status}}" ]; then echo "{{name}}: {{status}}"; exit 0; fi
        sleep 2
    done
    echo "{{name}}: timed out waiting for {{status}} (last: ${got:-unknown})" >&2
    echo "inspect with 'just bench status' or the leading controller's dashboard at {{ctrl}}/ui or {{ctrl2}}/ui" >&2
    exit 1

[group("streams")]
stream-rm name:
    #!/usr/bin/env bash
    set -euo pipefail
    headers="$(mktemp)"; body="$(mktemp)"; trap 'rm -f "$headers" "$body"' EXIT
    status="$(curl -s -o "$body" -D "$headers" -w '%{http_code}' {{tls}} {{nb_auth}} {{nb}}/streams/{{name}} || true)"
    case "$status" in
        200) ;;
        404) echo "not found: {{name}}"; exit 0 ;;
        *) echo "cannot read {{name}}: northbound returned $status $(cat "$body")" >&2; exit 1 ;;
    esac
    etag="$(awk 'tolower($1) == "etag:" { print $2 }' "$headers" | tr -d '\r')"
    status="$(curl -s -o "$body" -w '%{http_code}' {{tls}} {{nb_auth}} -H "If-Match: $etag" \
        -X DELETE {{nb}}/streams/{{name}} || true)"
    case "$status" in
        204) echo "deleted {{name}}" ;;
        404) echo "not found: {{name}}" ;;
        *) echo "cannot delete {{name}}: northbound returned $status $(cat "$body")" >&2; exit 1 ;;
    esac

[group("stack")]
leader:
    #!/usr/bin/env bash
    set -uo pipefail
    for pair in "controller {{ctrl}}" "controller-2 {{ctrl2}}"; do
        read -r svc url <<<"$pair"
        if [ "$(curl -s -o /dev/null -w '%{http_code}' "$url/status")" = 200 ]; then
            echo "$svc $url"
            exit 0
        fi
    done
    echo "no controller leads; 'just bench ps' shows which are up" >&2
    exit 1

[doc("Restart, kill or stop the leading controller with <stream> flowing and check that no Strom flow dropped.")]
[group("streams")]
controller-restart stream="basic" how="restart":
    #!/usr/bin/env bash
    set -euo pipefail
    case "{{how}}" in
        restart|kill|stop) ;;
        *) echo "how must be restart, kill or stop, not {{how}}" >&2; exit 2 ;;
    esac
    just stream-wait {{stream}} flowing 5 >/dev/null || {
        echo "{{stream}} is not flowing; 'just bench stream-up {{stream}}' drives it" >&2
        exit 1
    }
    snapshot() {
        for strom in {{strom1}} {{strom2}} {{strom3}} {{strom4}}; do
            curl -sf {{strom_auth}} "$strom/api/flows" \
                | jq -r '.flows[] | select(.name | startswith("weave-")) | "\(.name) \(.id)"' \
                | while read -r name id; do
                    moved="$(curl -sf {{strom_auth}} "$strom/api/flows/$id/srt-stats" \
                        | jq '[.. | objects | (.bytes_received // 0) + (.bytes_sent // 0)] | add // 0')"
                    echo "$name $id $moved"
                done
        done | sort
    }
    identity() {
        etag="$(curl -sf {{tls}} -D - -o /dev/null {{nb_auth}} {{nb}}/streams/{{stream}} \
            | tr -d '\r' | awk 'tolower($1) == "etag:" { print $2 }')"
        generation="$(curl -sf {{tls}} {{nb_auth}} {{nb}}/streams/{{stream}} | jq .generation)"
        echo "etag $etag generation $generation"
    }
    leader="$(just leader)"
    read -r old old_url <<<"$leader"
    echo "leading: $old"
    before="$(snapshot)"
    identity_before="$(identity)"
    echo "== weave- flows before (name id bytes) =="
    echo "$before"
    echo "{{stream}}: $identity_before"
    since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    case "{{how}}" in
        restart) {{compose}} restart "$old" ;;
        kill) docker kill -s KILL "ow-$old" >/dev/null && {{compose}} start "$old" ;;
        stop) {{compose}} stop "$old" ;;
    esac
    new=""
    for _ in $(seq 1 30); do
        if leader="$(just leader 2>/dev/null)"; then
            read -r new _ <<<"$leader"
            break
        fi
        sleep 1
    done
    [ -n "$new" ] || { echo "FAIL: no controller leads after {{how}}" >&2; exit 1; }
    echo "leading after {{how}}: $new; waiting 20s for every adapter to poll it"
    sleep 20
    after="$(snapshot)"
    echo "== weave- flows after =="
    echo "$after"
    failed=0
    if [ "{{how}}" = stop ] && [ "$new" = "$old" ]; then
        echo "FAIL: $old leads again while it should be down" >&2
        failed=1
    fi
    if [ "$(cut -d' ' -f1,2 <<<"$before")" != "$(cut -d' ' -f1,2 <<<"$after")" ]; then
        echo "FAIL: the set of weave- flows or their ids changed" >&2
        failed=1
    fi
    while read -r name id moved; do
        now="$(awk -v id="$id" '$2 == id { print $3 }' <<<"$after")"
        if [ -n "$now" ] && [ "$now" -le "$moved" ]; then
            echo "FAIL: $name moved no bytes across the switch ($moved -> $now)" >&2
            failed=1
        fi
    done <<<"$before"
    for adapter in ow-adapter-1 ow-adapter-2 ow-adapter-3 ow-adapter-4; do
        if docker logs --since "$since" "$adapter" 2>&1 | grep "deleted undesired managed flow"; then
            echo "FAIL: $adapter deleted a flow" >&2
            failed=1
        fi
    done
    for endpoint in ow-producer ow-producer-3 ow-producer-4 ow-consumer ow-consumer-2 ow-consumer-3 ow-consumer-4; do
        if docker logs --since "$since" "$endpoint" 2>/dev/null | grep "ffmpeg exited"; then
            echo "FAIL: $endpoint restarted ffmpeg" >&2
            failed=1
        fi
    done
    offline="$(curl -sf {{tls}} {{nb_auth}} {{nb}}/nodes \
        | jq -r '.[] | select((.id | startswith("strom-node-")) and .status == "offline") | .id')"
    if [ -n "$offline" ]; then
        echo "FAIL: offline after the switch: $offline" >&2
        failed=1
    fi
    identity_after="$(identity)"
    if [ "$identity_after" != "$identity_before" ]; then
        echo "FAIL: {{stream}} changed from '$identity_before' to '$identity_after'" >&2
        failed=1
    fi
    WEAVE_BENCH_DRIVING=1 just stream {{stream}} || { echo "FAIL: re-applying {{stream}} failed" >&2; failed=1; }
    just stream-wait {{stream}} flowing
    if [ "{{how}}" = stop ]; then
        {{compose}} start "$old"
        for _ in $(seq 1 30); do
            curl -sf "$old_url/health" >/dev/null 2>&1 && break
            sleep 1
        done
        sleep 3
        code="$(curl -s "$old_url/status" | jq -r .code)"
        leader="$(just leader)" || true
        read -r leading _ <<<"$leader"
        echo "$old is back: /status says ${code}; $leading leads"
        if [ "$code" != not_leader ] || [ "$leading" != "$new" ]; then
            echo "FAIL: $old did not come back as a standby" >&2
            failed=1
        fi
    fi
    [ "$failed" = 0 ] && echo "ok: every weave- flow kept its id and kept moving bytes"
    exit "$failed"

[doc("Start the external ffmpeg producer (SRT caller into a source ingress).")]
[group("media")]
producer-up stream="basic" passphrase="":
    #!/usr/bin/env bash
    set -euo pipefail
    target="$(WEAVE_NORTHBOUND_TOKEN={{nb_token}} bash {{scripts}}/endpoints.sh {{stream}} ingress)"
    svc="producer$(bash {{scripts}}/inside.sh "$target")"
    echo "producer: dialling $target from $svc"
    PRODUCER_TARGET="$target" PRODUCER_PASSPHRASE="{{passphrase}}" \
        {{compose}} --profile producer up -d "$svc"

