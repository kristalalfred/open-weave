browser-id node=browser_node svc="browser":
    #!/usr/bin/env bash
    set -euo pipefail
    for _ in $(seq 1 30); do
        got="$(curl -sf {{tls}} {{sb_auth}} {{sb}}/nodes \
            | jq -r --arg id '{{node}}' '.[] | select(.id==$id) | .id' 2>/dev/null || true)"
        if [ -n "$got" ]; then echo "$got"; exit 0; fi
        sleep 2
    done
    echo "{{node}} has not registered with southbound;" \
         "'just bench logs {{svc}}' shows why, 'just bench status' lists the nodes there are" >&2
    exit 1

