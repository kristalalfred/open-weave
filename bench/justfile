tls := "--cacert " + ca
cli := "SSL_CERT_FILE=" + ca + " WEAVE_NORTHBOUND_URL=" + nb + " cargo run --quiet -p weave-cli --"

nb_token := env("WEAVE_NORTHBOUND_TOKEN", "bench-northbound-token")
nb_auth  := "-H 'Authorization: Bearer " + nb_token + "'"
sb_key   := env("WEAVE_SOUTHBOUND_KEY", "bench-southbound-key-for-local-use-only")

sb_token := env("WEAVE_ADAPTER_1_TOKEN", "strom-node-1.0.dc18eb10e0f080536c55f9ff6569abb31d2da3ce4f782b294dd0d32fcbd8dbaf")
sb_auth  := "-H 'Authorization: Bearer " + sb_token + "'"

strom_key  := env("WEAVE_STROM_TOKEN", "bench-strom-key-for-local-use-only")
strom_auth := "-H 'Authorization: Bearer " + strom_key + "'"

browser_token := env("WEAVE_BROWSER_TOKEN", "browser-bench.0.ed7971623b06be894b581ccca99662bdb3983d232e8737a2c3e5a46455b00540")
browser_node  := replace_regex(browser_token, '\..*', '')
browser_2_token := env("WEAVE_BROWSER_2_TOKEN", "browser-bench-2.0.01b7733061b2fec1c70751c03fd9c027e962589084f12bbb6cee4c9a9e65ea82")
browser_2_node  := replace_regex(browser_2_token, '\..*', '')

hook_port := env("WEAVE_WEBHOOK_PORT", "29099")
hook_token := env("WEAVE_WEBHOOK_TOKEN", "bench-webhook-token")

default:
    @just --list

[group("stack")]
up:
    {{compose}} build controller
    {{compose}} up -d
    @just wait

[group("stack")]
wait:
    @echo "waiting for stack..."
    @for i in $(seq 1 90); do \
        curl -sf {{tls}} {{nb}}/health >/dev/null 2>&1 && \
        curl -sf {{tls}} {{sb}}/health >/dev/null 2>&1 && \
        curl -sf {{ctrl}}/health >/dev/null 2>&1 && \
        curl -sf {{ctrl2}}/health >/dev/null 2>&1 && \
        curl -sf {{strom_auth}} {{strom1}}/api/version >/dev/null 2>&1 && \
        curl -sf {{strom_auth}} {{strom2}}/api/version >/dev/null 2>&1 && \
        curl -sf {{strom_auth}} {{strom3}}/api/version >/dev/null 2>&1 && \
        curl -sf {{strom_auth}} {{strom4}}/api/version >/dev/null 2>&1 && \
        { echo "stack ready"; exit 0; }; \
        sleep 2; \
    done; echo "timeout waiting for stack" >&2; {{compose}} ps; exit 1

[group("stack")]
down:
    {{compose}} --profile producer --profile consumer --profile browser down -v --remove-orphans

[group("stack")]
topology name="default":
    #!/usr/bin/env bash
    set -euo pipefail
    case "{{name}}" in
        default) config=adapter-2.yaml ;;
        rist) config=adapter-2-rist.yaml ;;
        *) echo "unknown topology {{name}}: use default or rist" >&2; exit 1 ;;
    esac
    WEAVE_ADAPTER_2_CONFIG="$config" {{compose}} up -d adapter-2
    echo "adapter-2 runs with config/$config"

[group("stack")]
ps:
    {{compose}} ps

[group("stack")]
logs svc="controller":
    {{compose}} logs -f --tail=40 {{svc}}

[group("stack")]
status:
    @echo "== health =="
    @printf "northbound:  "; curl -sf {{tls}} {{nb}}/health >/dev/null && echo ok || echo DOWN
    @printf "southbound:  "; curl -sf {{tls}} {{sb}}/health >/dev/null && echo ok || echo DOWN
    @printf "controller:  "; curl -sf {{ctrl}}/health >/dev/null && echo ok || echo DOWN
    @printf "controller-2:"; curl -sf {{ctrl2}}/health >/dev/null && echo " ok" || echo " DOWN"
    @printf "leading:     "; just leader 2>&1 || true
    @printf "strom-1:     "; curl -sf {{strom_auth}} {{strom1}}/api/version >/dev/null && echo ok || echo DOWN
    @printf "strom-2:     "; curl -sf {{strom_auth}} {{strom2}}/api/version >/dev/null && echo ok || echo DOWN
    @printf "strom-3:     "; curl -sf {{strom_auth}} {{strom3}}/api/version >/dev/null && echo ok || echo DOWN
    @printf "strom-4:     "; curl -sf {{strom_auth}} {{strom4}}/api/version >/dev/null && echo ok || echo DOWN
    @echo "== registered nodes (southbound) =="
    @curl -sf {{tls}} {{sb_auth}} {{sb}}/nodes | (jq . 2>/dev/null || cat)
    @echo "== /status (northbound, from the leading controller) =="
    @curl -sf {{tls}} {{nb_auth}} {{nb}}/status | (jq . 2>/dev/null || cat)
    @echo "== streams (northbound) =="
    @curl -sf {{tls}} {{nb_auth}} {{nb}}/streams | (jq . 2>/dev/null || cat)

[doc("Check that a node token acts only for its own node.")]
[group("stack")]
auth-check:
    #!/usr/bin/env bash
    set -uo pipefail
    me="Authorization: Bearer {{sb_token}}"
    json="Content-Type: application/json"
    heartbeat='{"node_id":"strom-node-2","status":"ready","endpoints":[],"hop_status":[]}'
    leader="$(just leader)" || exit 1
    read -r _ ctrl <<<"$leader"
    failed=0
    expect() {
        local want="$1" what="$2"; shift 2
        local got; got="$(curl -s {{tls}} -o /dev/null -w '%{http_code}' "$@")"
        printf '%-46s %s\n' "$what" "$got"
        [ "$got" = "$want" ] || { echo "  expected $want" >&2; failed=1; }
    }
    expect 200 "southbound: desired hops as strom-node-1" -H "$me" {{sb}}/nodes/strom-node-1/desired
    expect 403 "southbound: desired hops as strom-node-2" -H "$me" {{sb}}/nodes/strom-node-2/desired
    expect 403 "southbound: heartbeat as strom-node-2" -H "$me" -H "$json" -d "$heartbeat" {{sb}}/nodes/strom-node-2/heartbeat
    expect 403 "southbound: register as strom-node-2" -H "$me" -H "$json" -d '{"node":{"id":"strom-node-2"}}' {{sb}}/nodes/register
    expect 403 "controller: desired hops as strom-node-2" -H "$me" "$ctrl/nodes/strom-node-2/desired"
    expect 403 "controller: heartbeat as strom-node-2" -H "$me" -H "$json" -d "$heartbeat" "$ctrl/nodes/strom-node-2/heartbeat"
    expect 401 "southbound: old shared token" -H "Authorization: Bearer bench-southbound-token" {{sb}}/nodes
    expect 401 "southbound: the key as a token" -H "Authorization: Bearer {{sb_key}}" {{sb}}/nodes
    exit "$failed"

[doc("Check that the TLS endpoints verify against the bench CA, and fail without it.")]
[group("stack")]
tls-check:
    #!/usr/bin/env bash
    set -uo pipefail
    failed=0
    check() {
        local what="$1"; shift
        if "$@" >/dev/null 2>&1; then r=yes; else r=NO; failed=1; fi
        printf '%-56s %s\n' "$what" "$r"
    }
    check "curl verifies northbound against the bench CA" curl -sf {{tls}} {{nb}}/health
    check "curl verifies southbound against the bench CA" curl -sf {{tls}} {{sb}}/health
    check "curl without the bench CA refuses southbound" sh -c 'curl -s {{sb}}/health; [ $? -eq 60 ]'
    check "weave trusts the bench CA from SSL_CERT_FILE" env WEAVE_NORTHBOUND_TOKEN={{nb_token}} {{cli}} get status
    check "weave without SSL_CERT_FILE refuses the certificate" sh -c 'env -u SSL_CERT_FILE WEAVE_NORTHBOUND_TOKEN={{nb_token}} cargo run --quiet -p weave-cli -- --url {{nb}} get status 2>&1 | grep -q UnknownIssuer'
    exit "$failed"

[group("streams")]
stream-ls:
